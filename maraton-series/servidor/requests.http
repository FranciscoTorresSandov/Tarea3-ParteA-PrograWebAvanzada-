# Solicitudes para REST Client (VS Code), etapas 2 a 6.
@api = http://localhost:3000/api
# Sustituya los IDs por ObjectId verdaderos obtenidos de las peticiones 4 a 6.
@miembroSofia = PEGUE_AQUI_EL_ID_DE_SOFIA
@serieId = PEGUE_AQUI_EL_ID_DE_LA_SERIE

### 1. GET /api/series -> 200 (en etapa 2, antes del módulo: 404)
GET {{api}}/series

### 2. Ruta inexistente -> 404
GET {{api}}/ruta-inexistente

### 3. JSON inválido -> 400 JSON_INVALIDO
POST {{api}}/series
Content-Type: application/json

{ "titulo":

### 4. Miembros -> 200
GET {{api}}/miembros

### 5. Series -> 200
GET {{api}}/series

### 6. Crear -> 201
POST {{api}}/series
Content-Type: application/json

{
  "titulo": "Severance",
  "genero": "Drama",
  "temporadas": 2,
  "miembroId": "{{miembroSofia}}"
}

### 7. Datos inválidos -> 400 DATOS_INVALIDOS
POST {{api}}/series
Content-Type: application/json

{
  "titulo": "S",
  "genero": "Terror",
  "temporadas": "dos",
  "miembroId": "123"
}

### 8. Miembro con ID válido inexistente -> 400
POST {{api}}/series
Content-Type: application/json

{
  "titulo": "Fargo", "genero": "Drama", "temporadas": 5,
  "miembroId": "650000000000000000000000"
}

### 9. PATCH estado -> 200
PATCH {{api}}/series/{{serieId}}/estado
Content-Type: application/json

{ "estado": "Viendo" }

### 10. PATCH estado inválido -> 400
PATCH {{api}}/series/{{serieId}}/estado
Content-Type: application/json

{ "estado": "Abandonada" }

### 11. ID inválido -> 400 ID_INVALIDO
PATCH {{api}}/series/abc/estado
Content-Type: application/json

{ "estado": "Vista" }

### 12. ID bien formado pero no existe -> 404 NO_ENCONTRADA
PATCH {{api}}/series/650000000000000000000000/estado
Content-Type: application/json

{ "estado": "Vista" }

### 13. DELETE -> 204 sin cuerpo
DELETE {{api}}/series/{{serieId}}

### 14. DELETE de nuevo -> 404
DELETE {{api}}/series/{{serieId}}
